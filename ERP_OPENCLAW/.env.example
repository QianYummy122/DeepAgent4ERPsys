# =============================================================================
# ERP_OPENCLAW 环境变量模板
# 复制为 .env 后按需修改：  copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 大模型（必填）
#    MAIN_MODEL / SUMMARY_MODEL 使用 OpenAI 兼容接口，默认指向 DeepSeek。
#    任何 OpenAI 兼容服务（DeepSeek / 智谱 / 通义 / 本地 vLLM 等）均可。
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MAIN_MODEL_NAME=deepseek-chat
SUMMARY_MODEL_NAME=deepseek-chat

# 备用模型（可选，未配置则跳过）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# -----------------------------------------------------------------------------
# 2. MongoDB（必填）
#    用于对话检查点（HITL 中断恢复）与会话历史展示。
#    本机默认安装即可用：mongodb://127.0.0.1:27017/
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB_NAME=langchain_db
MONGODB_CHECKPOINT_COLLECTION=checkpoints

# -----------------------------------------------------------------------------
# 3. 沙箱（代码执行环境）
#    local       —— 使用本机 WSL 发行版，免部署（Windows 推荐）
#    opensandbox —— 连接自行部署的 OpenSandbox 服务
# -----------------------------------------------------------------------------
SANDBOX_MODE=local
WSL_DISTRO=Ubuntu-20.04
WSL_USER=root
# 首次启动是否在沙箱内创建 /opt/skills-venv 并预装 numpy/pandas/matplotlib 等
SANDBOX_SETUP_VENV=1
SANDBOX_PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# OpenSandbox 模式专用
OPENSANDBOX_DOMAIN=http://127.0.0.1:8080
OPENSANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.2

# -----------------------------------------------------------------------------
# 4. MCP 服务地址
#    ERP_MCP_URL      —— 本地 ERP 桥接服务（本仓库 src/mcp_server）
#    ANALYSIS_MCP_URL —— 远程可视化 MCP（26 个图表工具），留空则不加载图表工具
# -----------------------------------------------------------------------------
ERP_MCP_URL=http://127.0.0.1:8000/mcp
ANALYSIS_MCP_URL=https://mcp.api-inference.modelscope.net/af3893df5be041/mcp

# -----------------------------------------------------------------------------
# 5. Java ERP 后端
# -----------------------------------------------------------------------------
JAVA_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# 6. 其它
# -----------------------------------------------------------------------------
APP_ENV=development
